Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	Scroll.CanvasSize = UDim2.new(
		0,
		0,
		0,
		Layout.AbsoluteContentSize.Y + 10
	)
end)


local Counter = Instance.new("TextLabel")
Counter.Parent = Frame
Counter.Position = UDim2.new(0,10,0,315)
Counter.Size = UDim2.new(1,-20,0,25)
Counter.BackgroundTransparency = 1
Counter.TextColor3 = Color3.new(1,1,1)
Counter.Text = "Selecionados: 0"


local DelayBox = Instance.new("TextBox")
DelayBox.Parent = Frame
DelayBox.Position = UDim2.new(0,10,0,345)
DelayBox.Size = UDim2.new(0,100,0,30)
DelayBox.Text = "0.1"
DelayBox.BackgroundColor3 = Color3.fromRGB(40,40,45)
DelayBox.TextColor3 = Color3.new(1,1,1)


DelayBox.FocusLost:Connect(function()
	local n = tonumber(DelayBox.Text)
	if n then
		Delay = n
	end
end)


local function UpdateCounter()
	local n = 0

	for _,v in pairs(Selected) do
		if v then
			n += 1
		end
	end

	Counter.Text = "Selecionados: "..n
end



for _,name in ipairs(Effects) do

	local Button = Instance.new("TextButton")
	Button.Parent = Scroll
	Button.Size = UDim2.new(1,-5,0,32)
	Button.BackgroundColor3 = Color3.fromRGB(45,45,50)
	Button.Text = "☐ "..name
	Button.TextColor3 = Color3.new(1,1,1)

	Instance.new("UICorner",Button)


	Button.MouseButton1Click:Connect(function()

		Selected[name] = not Selected[name]

		if Selected[name] then
			Button.Text = "☑ "..name
			Button.BackgroundColor3 = Color3.fromRGB(100,50,200)
		else
			Button.Text = "☐ "..name
			Button.BackgroundColor3 = Color3.fromRGB(45,45,50)
		end

		UpdateCounter()

	end)

end

